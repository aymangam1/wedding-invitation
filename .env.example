# Copy this file to `.env` and fill in the values from your Supabase project.
# Both values are safe to expose in the browser: the publishable key only ever
# gets the access that Row Level Security allows.
#
# Project URL:      Supabase -> Project Settings -> Data API
# Publishable key:  Supabase -> Project Settings -> API Keys -> Publishable key
#
# Never put the secret key (sb_secret_...) here. It bypasses Row Level Security.
#
# Leave them empty to run the guest book in local-only fallback mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
